# GitHub repo where your .zshrc and .gitconfig is located. 
# See https://github.com/thisistonydang/dotfiles for an example.
# This is optional. Use an empty string to skip. (e.g. DOTFILES="")
DOTFILES_REPO=thisistonydang/dotfiles

# IP address of the server to set up.
IP=0.0.0.0

# Postgres variables in order to set up regular db backups using rclone. This
# assumes you have postgres running locally on your server at 127.0.0.1:5432.
# This is optional. Use an empty string for POSTGRES_VERSION to skip. (e.g. POSTGRES_VERSION="")
POSTGRES_VERSION=18
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=your_db_name
POSTGRES_USER=your_postgres_username
POSTGRES_PASS=your_postgres_password

# Username for the non-root user with sudo privileges.
USERNAME=exampleuser